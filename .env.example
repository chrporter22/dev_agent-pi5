# -------------------------
# OpenClaw Pi — Environment
# -------------------------
# All real values go in .env (gitignored). This file ships placeholders only.
#
# Bring-up (see README → "Bring-up" for the full walk-through):
#   1. Message @BotFather on Telegram, /newbot, copy the token to TELEGRAM_TOKEN.
#   2. Message @userinfobot, copy the numeric id to ALLOWED_USER.
#   3. cp .env.example .env   (only if .env doesn't already exist)
#   4. Edit the two lines above. Everything else is fine for a first run.
#   5. docker compose -f docker-compose.prod.yml up -d --build

# -------------------------
# Telegram
# -------------------------
# ALLOWED_USER must be numeric — it is parsed with int(). 0 means "no user
# authorized", so the bot starts but rejects every command until you set it.
# BotFather gives you TELEGRAM_TOKEN; @userinfobot gives you ALLOWED_USER.
TELEGRAM_TOKEN=your_telegram_bot_token_here
ALLOWED_USER=0

# -------------------------
# Bot Version (used for image tag)
# -------------------------
BOT_VERSION=1.0.0

# -------------------------
# Redis ACL — one user per service.
# Each user authenticates with its own password + has its own key-pattern scope.
# Generate strong random passwords per service (e.g. `openssl rand -hex 32`).
# -------------------------
REDIS_HOST=redis
REDIS_PORT=6379

REDIS_USER_BOT=bot
REDIS_PASSWORD_BOT=replace_me_with_strong_random

REDIS_USER_WORKER=worker
REDIS_PASSWORD_WORKER=replace_me_with_strong_random

REDIS_USER_ML=ml
REDIS_PASSWORD_ML=replace_me_with_strong_random

REDIS_USER_NODEAPI=nodeapi
REDIS_PASSWORD_NODEAPI=replace_me_with_strong_random

# Back-compat: legacy single password (no longer used; default user is `off`).
REDIS_PASSWORD=replace_me_with_strong_random

# -------------------------
# External AI Gateway (LiteLLM)
# -------------------------
# The worker sends job instructions + chat messages to this gateway.
# The gateway handles all LLM inference; this repo just forwards the request.
# User launches the gateway separately (out of scope for this repo).
#
# IMPORTANT: target the orchestrator on port 4001, NOT LiteLLM on 4000.
# The orchestrator is the gateway's single ingress and the one that records
# decisions, routes by tier, and attributes spend. Calling LiteLLM directly
# bypasses all of that.
#
# AI_GATEWAY_ALLOWED_MODELS defaults to "company-coder". The gateway's
# /v1/models on the orchestrator (4001) returns exactly this one public model.
AI_GATEWAY_BASE_URL=http://host.docker.internal:4001
AI_GATEWAY_API_KEY=your_scoped_virtual_key_here
AI_GATEWAY_MODEL=company-coder
AI_GATEWAY_TIMEOUT=150
AI_GATEWAY_MAX_TOKENS=8000
AI_GATEWAY_ALLOWED_MODELS=company-coder

# -------------------------
# GitHub — bot creates branches + opens PRs via the worker.
# Fine-grained PAT; scopes: contents:write, pull_requests:write on target repos.
# -------------------------
GITHUB_TOKEN=ghp_replace_me

# Optional: default repo for /build when no owner/repo prefix is given.
# Format: owner/repo
DEFAULT_REPO=

# -------------------------
# Worker sandbox — git operations live here.
# -------------------------
SANDBOX_DIR=/sandbox

# -------------------------
# Optional Debug / Logging
# -------------------------
LOG_LEVEL=info
ML_LOG_LEVEL=INFO
