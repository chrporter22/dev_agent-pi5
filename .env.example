# -------------------------
# OpenClaw Pi — Environment
# -------------------------
# All real values go in .env (gitignored). This file ships placeholders only.

# -------------------------
# Telegram
# -------------------------
TELEGRAM_TOKEN=your_telegram_bot_token_here
ALLOWED_USER=your_telegram_user_id_here

# -------------------------
# Bot Version (used for image tag)
# -------------------------
BOT_VERSION=1.0.0

# -------------------------
# Redis ACL — one user per service.
# Each user authenticates with its own password + has its own key-pattern scope.
# Generate strong random passwords per service (e.g. `openssl rand -hex 32`).
# -------------------------
REDIS_HOST=redis
REDIS_PORT=6379

REDIS_USER_BOT=bot
REDIS_PASSWORD_BOT=replace_me_with_strong_random

REDIS_USER_WORKER=worker
REDIS_PASSWORD_WORKER=replace_me_with_strong_random

REDIS_USER_ML=ml
REDIS_PASSWORD_ML=replace_me_with_strong_random

REDIS_USER_NODEAPI=nodeapi
REDIS_PASSWORD_NODEAPI=replace_me_with_strong_random

# Back-compat: legacy single password (no longer used; default user is `off`).
REDIS_PASSWORD=replace_me_with_strong_random

# -------------------------
# External AI Gateway (LiteLLM)
# -------------------------
# The worker sends job instructions + chat messages to this gateway.
# The gateway handles all LLM inference; this repo just forwards the request.
# User launches the gateway separately (out of scope for this repo).
AI_GATEWAY_BASE_URL=https://your-litellm-host.example.com
AI_GATEWAY_API_KEY=your_litellm_api_key_here
AI_GATEWAY_MODEL=gpt-4o-mini

# -------------------------
# GitHub — bot creates branches + opens PRs via the worker.
# Fine-grained PAT; scopes: contents:write, pull_requests:write on target repos.
# -------------------------
GITHUB_TOKEN=ghp_replace_me

# Optional: default repo for /build when no owner/repo prefix is given.
# Format: owner/repo
DEFAULT_REPO=

# -------------------------
# Worker sandbox — git operations live here.
# -------------------------
SANDBOX_DIR=/sandbox

# -------------------------
# Optional Debug / Logging
# -------------------------
LOG_LEVEL=info
ML_LOG_LEVEL=INFO
